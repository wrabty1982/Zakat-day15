generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model addresses {
  address_id     BigInt    @id @default(autoincrement())
  customer_id    BigInt
  city_id        BigInt
  street_address String
  postal_code    String?
  is_default     Boolean   @default(false)
  cities         cities    @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction)
  customers      customers @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
  orders         orders[]
}

model audit_logs {
  audit_id      BigInt   @id @default(autoincrement())
  actor_user_id BigInt?
  table_name    String
  action        String
  old_data      Json?
  new_data      Json?
  occurred_at   DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model brands {
  brand_id   BigInt     @id @default(autoincrement())
  brand_name String     @unique
  products   products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaigns {
  campaign_id   BigInt   @id @default(autoincrement())
  campaign_name String
  start_date    DateTime @db.Date
  end_date      DateTime @db.Date
  budget        Decimal? @db.Decimal(12, 2)
}

model carriers {
  carrier_id     BigInt           @id @default(autoincrement())
  carrier_name   String           @unique
  shipments      shipments[]
  shipping_rates shipping_rates[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  cart_id          BigInt
  variant_id       BigInt
  quantity         Int
  carts            carts            @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cart_id, variant_id])
}

model carts {
  cart_id     BigInt       @id @default(autoincrement())
  customer_id BigInt
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  cart_items  cart_items[]
  customers   customers    @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
}

model categories {
  category_id      BigInt       @id @default(autoincrement())
  parent_id        BigInt?
  category_name    String       @unique
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
}

model cities {
  city_id    BigInt       @id @default(autoincrement())
  region_id  BigInt
  city_name  String
  addresses  addresses[]
  regions    regions      @relation(fields: [region_id], references: [region_id], onDelete: NoAction, onUpdate: NoAction)
  warehouses warehouses[]
}

model countries {
  country_code   String           @id @db.Char(2)
  country_name   String
  regions        regions[]
  shipping_rates shipping_rates[]
}

model coupon_redemptions {
  coupon_id   BigInt
  order_id    BigInt    @unique
  redeemed_at DateTime? @default(now()) @db.Timestamptz(6)
  coupons     coupons   @relation(fields: [coupon_id], references: [coupon_id], onDelete: NoAction, onUpdate: NoAction)
  orders      orders    @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([coupon_id, order_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  coupon_id          BigInt               @id @default(autoincrement())
  coupon_code        String               @unique
  percent_off        Decimal              @db.Decimal(5, 2)
  starts_at          DateTime?            @db.Timestamptz(6)
  expires_at         DateTime?            @db.Timestamptz(6)
  coupon_redemptions coupon_redemptions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customers {
  customer_id     BigInt            @id @default(autoincrement())
  user_id         BigInt            @unique
  loyalty_points  Int               @default(0)
  date_of_birth   DateTime?         @db.Date
  addresses       addresses[]
  carts           carts[]
  users           users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  orders          orders[]
  reviews         reviews[]
  support_tickets support_tickets[]
  wishlists       wishlists[]
}

model login_attempts {
  attempt_id   BigInt   @id @default(autoincrement())
  user_id      BigInt?
  attempted_at DateTime @default(now()) @db.Timestamptz(6)
  success      Boolean
  ip_address   String?  @db.Inet
  users        users?   @relation(fields: [user_id], references: [user_id], onUpdate: NoAction)
}

model notifications {
  notification_id BigInt    @id @default(autoincrement())
  user_id         BigInt
  message         String
  read_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  order_item_id    BigInt           @id @default(autoincrement())
  order_id         BigInt
  variant_id       BigInt
  quantity         Int
  unit_price       Decimal          @db.Decimal(12, 2)
  discount_amount  Decimal          @default(0) @db.Decimal(12, 2)
  orders           orders           @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)
  returns          returns[]

  @@index([variant_id], map: "idx_order_items_variant")
}

model order_status_history {
  history_id     BigInt         @id @default(autoincrement())
  order_id       BigInt
  status_code    String
  changed_at     DateTime       @default(now()) @db.Timestamptz(6)
  orders         orders         @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  order_statuses order_statuses @relation(fields: [status_code], references: [status_code], onDelete: NoAction, onUpdate: NoAction)
}

model order_statuses {
  status_code          String                 @id
  description          String?
  order_status_history order_status_history[]
  orders               orders[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  order_id             BigInt                 @id @default(autoincrement())
  customer_id          BigInt
  address_id           BigInt?
  status_code          String
  ordered_at           DateTime               @default(now()) @db.Timestamptz(6)
  shipping_fee         Decimal                @default(0) @db.Decimal(12, 2)
  notes                String?
  coupon_redemptions   coupon_redemptions?
  order_items          order_items[]
  order_status_history order_status_history[]
  addresses            addresses?             @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction)
  customers            customers              @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  order_statuses       order_statuses         @relation(fields: [status_code], references: [status_code], onDelete: NoAction, onUpdate: NoAction)
  payments             payments[]
  shipments            shipments[]
  support_tickets      support_tickets[]

  @@index([customer_id, ordered_at(sort: Desc)], map: "idx_orders_customer_date")
  @@index([status_code, ordered_at(sort: Desc)], map: "idx_orders_status_date")
}

model payment_methods {
  method_id   BigInt     @id @default(autoincrement())
  method_name String     @unique
  payments    payments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  payment_id      BigInt          @id @default(autoincrement())
  order_id        BigInt
  method_id       BigInt
  amount          Decimal         @db.Decimal(12, 2)
  status          String
  paid_at         DateTime?       @db.Timestamptz(6)
  payment_methods payment_methods @relation(fields: [method_id], references: [method_id], onDelete: NoAction, onUpdate: NoAction)
  orders          orders          @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  refunds         refunds[]
}

model permissions {
  permission_id    BigInt             @id @default(autoincrement())
  permission_code  String             @unique
  description      String?
  role_permissions role_permissions[]
}

model product_images {
  image_id   BigInt   @id @default(autoincrement())
  product_id BigInt
  image_url  String
  sort_order Int      @default(0)
  products   products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
}

model product_price_history {
  history_id BigInt   @id @default(autoincrement())
  product_id BigInt
  old_price  Decimal? @db.Decimal(12, 2)
  new_price  Decimal  @db.Decimal(12, 2)
  changed_at DateTime @default(now()) @db.Timestamptz(6)
  products   products @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
}

model product_tag_links {
  product_id   BigInt
  tag_id       BigInt
  products     products     @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  product_tags product_tags @relation(fields: [tag_id], references: [tag_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, tag_id])
}

model product_tags {
  tag_id            BigInt              @id @default(autoincrement())
  tag_name          String              @unique
  product_tag_links product_tag_links[]
}

model product_variants {
  variant_id           BigInt                 @id @default(autoincrement())
  product_id           BigInt
  variant_sku          String                 @unique
  color                String?
  size                 String?
  price_delta          Decimal                @default(0) @db.Decimal(12, 2)
  cart_items           cart_items[]
  order_items          order_items[]
  products             products               @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  purchase_order_items purchase_order_items[]
  stock_movements      stock_movements[]
  stocks               stocks[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  product_id            BigInt                  @id @default(autoincrement())
  category_id           BigInt
  brand_id              BigInt?
  sku                   String                  @unique
  product_name          String
  description           String?
  base_price            Decimal                 @db.Decimal(12, 2)
  attributes            Json                    @default("{}")
  tags                  String[]                @default([])
  active                Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  product_images        product_images[]
  product_price_history product_price_history[]
  product_tag_links     product_tag_links[]
  product_variants      product_variants[]
  brands                brands?                 @relation(fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction)
  categories            categories              @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  reviews               reviews[]
  wishlist_items        wishlist_items[]

  @@index([attributes], map: "idx_products_attributes_gin", type: Gin)
  @@index([category_id, base_price], map: "idx_products_category_price")
  @@index([tags], map: "idx_products_tags_gin", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_order_items {
  purchase_order_id BigInt
  variant_id        BigInt
  quantity          Int
  unit_cost         Decimal          @db.Decimal(12, 2)
  purchase_orders   purchase_orders  @relation(fields: [purchase_order_id], references: [purchase_order_id], onDelete: Cascade, onUpdate: NoAction)
  product_variants  product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([purchase_order_id, variant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_orders {
  purchase_order_id    BigInt                 @id @default(autoincrement())
  supplier_id          BigInt
  warehouse_id         BigInt
  status               String                 @default("draft")
  ordered_at           DateTime               @default(now()) @db.Timestamptz(6)
  purchase_order_items purchase_order_items[]
  suppliers            suppliers              @relation(fields: [supplier_id], references: [supplier_id], onDelete: NoAction, onUpdate: NoAction)
  warehouses           warehouses             @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model refunds {
  refund_id   BigInt    @id @default(autoincrement())
  payment_id  BigInt
  amount      Decimal   @db.Decimal(12, 2)
  reason      String?
  refunded_at DateTime? @default(now()) @db.Timestamptz(6)
  payments    payments  @relation(fields: [payment_id], references: [payment_id], onDelete: NoAction, onUpdate: NoAction)
}

model regions {
  region_id    BigInt    @id @default(autoincrement())
  country_code String    @db.Char(2)
  region_name  String
  cities       cities[]
  countries    countries @relation(fields: [country_code], references: [country_code], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model returns {
  return_id     BigInt      @id @default(autoincrement())
  order_item_id BigInt
  quantity      Int
  reason        String?
  status        String      @default("requested")
  order_items   order_items @relation(fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  review_id   BigInt    @id @default(autoincrement())
  customer_id BigInt
  product_id  BigInt
  rating      Int
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customer_id, product_id])
  @@index([product_id, rating], map: "idx_reviews_product_rating")
}

model role_permissions {
  role_id       BigInt
  permission_id BigInt
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  role_id          BigInt             @id @default(autoincrement())
  role_name        String             @unique
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model shipment_events {
  event_id    BigInt    @id @default(autoincrement())
  shipment_id BigInt
  event_type  String
  event_at    DateTime  @default(now()) @db.Timestamptz(6)
  details     Json      @default("{}")
  shipments   shipments @relation(fields: [shipment_id], references: [shipment_id], onDelete: Cascade, onUpdate: NoAction)
}

model shipments {
  shipment_id     BigInt            @id @default(autoincrement())
  order_id        BigInt
  carrier_id      BigInt?
  tracking_number String?           @unique
  status          String            @default("pending")
  shipped_at      DateTime?         @db.Timestamptz(6)
  delivered_at    DateTime?         @db.Timestamptz(6)
  shipment_events shipment_events[]
  carriers        carriers?         @relation(fields: [carrier_id], references: [carrier_id], onDelete: NoAction, onUpdate: NoAction)
  orders          orders            @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shipping_rates {
  rate_id      BigInt    @id @default(autoincrement())
  carrier_id   BigInt
  country_code String    @db.Char(2)
  base_fee     Decimal   @db.Decimal(12, 2)
  carriers     carriers  @relation(fields: [carrier_id], references: [carrier_id], onDelete: NoAction, onUpdate: NoAction)
  countries    countries @relation(fields: [country_code], references: [country_code], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  movement_id      BigInt           @id @default(autoincrement())
  warehouse_id     BigInt
  variant_id       BigInt
  quantity_change  Int
  reason           String
  moved_at         DateTime         @default(now()) @db.Timestamptz(6)
  product_variants product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)
  warehouses       warehouses       @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stocks {
  warehouse_id      BigInt
  variant_id        BigInt
  quantity          Int              @default(0)
  reserved_quantity Int              @default(0)
  product_variants  product_variants @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction)
  warehouses        warehouses       @relation(fields: [warehouse_id], references: [warehouse_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([warehouse_id, variant_id])
}

model suppliers {
  supplier_id     BigInt            @id @default(autoincrement())
  supplier_name   String
  email           String?
  purchase_orders purchase_orders[]
}

model support_tickets {
  ticket_id       BigInt            @id @default(autoincrement())
  customer_id     BigInt
  order_id        BigInt?
  subject         String
  status          String            @default("open")
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  customers       customers         @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  orders          orders?           @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  ticket_messages ticket_messages[]
}

model system_settings {
  setting_key   String @id
  setting_value Json
}

model ticket_messages {
  message_id      BigInt          @id @default(autoincrement())
  ticket_id       BigInt
  author_user_id  BigInt?
  message_body    String
  sent_at         DateTime?       @default(now()) @db.Timestamptz(6)
  users           users?          @relation(fields: [author_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  support_tickets support_tickets @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_roles {
  user_id     BigInt
  role_id     BigInt
  assigned_at DateTime? @default(now()) @db.Timestamptz(6)
  roles       roles     @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model user_sessions {
  session_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    BigInt
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  user_id         BigInt            @id @default(autoincrement())
  email           String            @unique
  password_hash   String
  full_name       String
  phone           String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  metadata        Json              @default("{}")
  audit_logs      audit_logs[]
  customers       customers?
  login_attempts  login_attempts[]
  notifications   notifications[]
  ticket_messages ticket_messages[]
  user_roles      user_roles[]
  user_sessions   user_sessions[]
}

model warehouses {
  warehouse_id    BigInt            @id @default(autoincrement())
  warehouse_name  String
  city_id         BigInt?
  purchase_orders purchase_orders[]
  stock_movements stock_movements[]
  stocks          stocks[]
  cities          cities?           @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction)
}

model wishlist_items {
  wishlist_id BigInt
  product_id  BigInt
  products    products  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  wishlists   wishlists @relation(fields: [wishlist_id], references: [wishlist_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([wishlist_id, product_id])
}

model wishlists {
  wishlist_id    BigInt           @id @default(autoincrement())
  customer_id    BigInt
  wishlist_name  String           @default("My wishlist")
  wishlist_items wishlist_items[]
  customers      customers        @relation(fields: [customer_id], references: [customer_id], onDelete: Cascade, onUpdate: NoAction)
}
